#include 'actions/text'
#include 'actions/web'
#include 'actions/calendar'

#define name Upload Running README
#define color green
#define outputs text

// Build with scripts/check-cherri.py to preserve the exported Actions metadata.
action 'com.sindresorhus.Actions.WorkoutAppEntity' findWorkouts(): array {
    "WFContentItemSortProperty": "startDate",
    "WFContentItemSortOrder": "Latest First",
    "WFContentItemLimitEnabled": false
}

action 'com.sindresorhus.Actions.KeychainGetIntent' getIngestToken(text key: 'key'): text

const offset = formatDate(CurrentDate, "Custom", "XXX")
if offset != "+09:00" {
    showNotification("端末のタイムゾーンを日本時間にして実行してください。", "Running README", false)
    stop()
}

const workouts = findWorkouts()
const blocks = for workout in workouts {
    const block = if @workout['workoutType'].text == "Running" {
        const start = formatDate(@workout['startDate'], "Custom", "yyyy/MM/dd HH:mm:ss")
        const duration = getText(@workout['duration'])
        const distance = getText(@workout['totalDistance'])
        const speed = getText(@workout['averageSpeed'])
        text("Workout Type: Running\nDate: {start}\nDuration: {duration}\nDistance: {distance}\nAvg Speed: {speed}")
    } else {
        nothing()
    }
    getText(block)
}
const joined = joinText(blocks, "\n\n")
const workoutsText = trimWhitespace(joined)
if !workoutsText {
    showNotification("Runningの入力がないため送信しません。", "Running README", false)
    stop()
}

const token = getIngestToken("running-readme.ingest-token")
if !token {
    showNotification("Actions Keychainに更新トークンを設定してください。", "Running README", false)
    stop()
}

const response = jsonRequest(
    "https://running-readme-api.amtt.workers.dev/v1/workouts",
    "POST",
    {"workoutsText": "{workoutsText}"},
    {"Authorization": "Bearer {token}", "Content-Type": "application/json"}
)
const result = getDictionary(response)
const acceptedValue = getValue(result, "ok")
const accepted = number(acceptedValue)
if accepted != 1 {
    showNotification("同期に失敗しました。APIの応答を確認してください。", "Running README", false)
    stop()
}
showNotification("年間合計と直近5件を更新しました。", "Running README", false)
output("{result}")
